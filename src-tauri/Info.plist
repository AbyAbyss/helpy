<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this, macOS denies the microphone silently and never lists Helpy
	     under Privacy & Security. Tauri merges this file into the app bundle. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Helpy listens when you hold the voice shortcut, so you can talk to it.</string>
</dict>
</plist>
