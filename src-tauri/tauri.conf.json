{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helpy",
  "version": "0.1.0",
  "identifier": "com.helpy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Helpy Settings",
        "width": 1040,
        "height": 720,
        "minWidth": 780,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "ask",
        "url": "ask.html",
        "title": "Helpy",
        "width": 440,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "contentProtected": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "pill",
        "url": "pill.html",
        "title": "Helpy voice",
        "width": 300,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "contentProtected": true,
        "visibleOnAllWorkspaces": true,
        "minWidth": 40,
        "minHeight": 40
      },
      {
        "label": "agents",
        "url": "agents.html",
        "title": "Helpy agents",
        "width": 1040,
        "height": 700,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "dockcard",
        "url": "dockcard.html",
        "title": "Helpy agent",
        "width": 360,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "contentProtected": true,
        "visibleOnAllWorkspaces": true,
        "minWidth": 1,
        "minHeight": 1
      },
      {
        "label": "dock",
        "url": "dock.html",
        "title": "Helpy agents",
        "width": 64,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "contentProtected": true,
        "visibleOnAllWorkspaces": true,
        "minWidth": 1,
        "minHeight": 1
      },
      {
        "label": "plan",
        "url": "plan.html",
        "title": "Helpy agents plan",
        "width": 460,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "visible": false,
        "contentProtected": true,
        "visibleOnAllWorkspaces": true,
        "minWidth": 40,
        "minHeight": 40
      },
      {
        "label": "step",
        "url": "step.html",
        "title": "Helpy step",
        "width": 360,
        "height": 170,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "contentProtected": true,
        "visibleOnAllWorkspaces": true,
        "minWidth": 40,
        "minHeight": 40
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 200
        }
      }
    }
  }
}
